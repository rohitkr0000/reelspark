# Razorpay API keys for the razorpay-create-order / razorpay-verify-payment functions.
# Get them from the Razorpay Dashboard → Settings → API Keys.
# Set them on the deployed project with:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxx RAZORPAY_KEY_SECRET=xxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
